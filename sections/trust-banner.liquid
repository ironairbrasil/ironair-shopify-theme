          "default": "inherit",
          "options": [
            {
              "value": "inherit",
              "label": "Herdar da seção"
            },
            {
              "value": "left",
              "label": "Esquerda"
            },
            {
              "value": "center",
              "label": "Centro"
            },
            {
              "value": "right",
              "label": "Direita"
            }
