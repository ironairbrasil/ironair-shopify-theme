{{ 'trust-banner.css' | asset_url | stylesheet_tag }}

<div class="mobile-scroll-shell mobile-scroll-shell-trust theme-text-align-{{ section.settings.text_alignment | default: 'left' }} theme-mobile-text-align-{{ section.settings.mobile_text_alignment | default: section.settings.text_alignment | default: 'left' }} theme-content-align-{{ section.settings.content_alignment | default: section.settings.text_alignment | default: 'left' }} theme-mobile-content-align-{{ section.settings.mobile_content_alignment | default: section.settings.content_alignment | default: section.settings.mobile_text_alignment | default: section.settings.text_alignment | default: 'left' }}{% if section.settings.hide_on_mobile %} theme-hide-mobile{% endif %}{% if section.settings.hide_on_desktop %} theme-hide-desktop{% endif %}">
  <section class="trust-banner shopify-padding-section" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; margin-top: 0; margin-bottom: 0;">
    {% for block in section.blocks %}
      <div class="trust-item theme-block-align-{{ block.settings.block_text_alignment | default: 'inherit' }} theme-block-mobile-align-{{ block.settings.block_mobile_text_alignment | default: block.settings.block_text_alignment | default: 'inherit' }}" {{ block.shopify_attributes }}>
        <div class="trust-icon">{% render 'icon', icon: block.settings.icon %}</div>
        <div class="trust-label">
          <h1 class="trust-label-title">{{ block.settings.title }}</h1>
          <span>{{ block.settings.text }}</span>
        </div>
      </div>
    {% endfor %}
  </section>
</div>

{% schema %}
{
